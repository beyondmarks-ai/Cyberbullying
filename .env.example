# Instagram account monitored by the local dashboard
IG_POLL_SECONDS=60
# From Instagram > API setup with Instagram login > Business login settings
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://YOUR-HOST/auth/instagram/callback
IG_WEBHOOK_URL=https://YOUR-HOST/webhooks/instagram

# Azure OpenAI: copy from the resource's Keys and Endpoint page (no CLI login)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Sarvam speech-to-text
SARVAM_API_KEY=

# Google AI Studio API key: https://aistudio.google.com/apikey
# Alternatively use vertex-express with a Vertex AI Express Mode API key.
# Keys, model access, billing, and data terms are specific to the selected API.
GEMINI_API_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sensitive screening: independent Azure + Gemini text assessments (extra API usage)
MODERATION_TEXT_SECOND_OPINION=true
# Native audio/video: overlapping 60s segments, up to 10 minutes per attachment.
# Clamped to 60-1800 seconds; anything beyond the limit is marked Needs review.
MODERATION_MAX_MEDIA_SECONDS=600

# Private Azure Blob previews (one-time Azure CLI/portal setup; no CLI needed at runtime)
# Use a dedicated account with public blob access disabled and the seven-day lifecycle rule.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=instagram-previews
AZURE_STORAGE_KEY=
