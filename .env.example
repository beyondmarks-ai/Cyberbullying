# Instagram account monitored by the local dashboard
IG_POLL_SECONDS=60
# From Instagram > API setup with Instagram login > Business login settings
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://YOUR-HOST/auth/instagram/callback
IG_WEBHOOK_URL=https://YOUR-HOST/webhooks/instagram

# Azure OpenAI (the CLI login is used to retrieve the key at runtime)
AZURE_OPENAI_GROUP=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Sarvam speech-to-text
SARVAM_API_KEY=

# Vertex AI (GOOGLE_CLOUD_PROJECT may be omitted when configured in gcloud)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_VIDEO_MODEL=gemini-3.8-flash
